---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import TechTags from './TechTags.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  // Show the screenshot panel. Off for groups where no project has a cover.
  media?: boolean;
}

const { project, media = true } = Astro.props;
const { title, subtitle, tagline, tech, status, cover } = project.data;

const badge = {
  live: null,
  'in-progress': 'In progress',
  'client-work': 'Client work',
  'personal-project': 'Personal project',
  'masters-thesis': "Master's thesis",
  workshop: 'Workshop',
  demo: 'Demo',
}[status ?? 'live'];
---

<article class="group relative flex flex-col overflow-hidden rounded-xl border border-zinc-200 bg-zinc-50 transition hover:border-accent dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-accent-soft" data-reveal>
  {/* Cards without a screenshot get a plain panel of the same size so rows stay aligned. */}
  {media && <div class="relative aspect-video border-b border-zinc-200 bg-zinc-100 dark:border-zinc-800 dark:bg-zinc-950">
    {cover
      ? <Image src={cover.src} alt={cover.alt} widths={[400, 800]} sizes="(min-width: 640px) 420px, 100vw" class="absolute inset-0 size-full object-cover object-top transition duration-300 group-hover:scale-[1.02]" />
      : <div class="flex size-full items-center justify-center font-mono text-sm text-zinc-500" aria-hidden="true">{'// '}{project.id}</div>}
  </div>}
  <div class="flex flex-1 flex-col p-5">
    <div class="flex items-start justify-between gap-3">
      <h4 class="text-lg font-semibold">
        <a href={`/projects/${project.id}/`} class="after:absolute after:inset-0">{title}</a>
      </h4>
      {badge && (
        <span class="shrink-0 rounded-full bg-zinc-100 px-2 py-0.5 font-mono text-xs dark:bg-zinc-800">{badge}</span>
      )}
    </div>
    <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">{subtitle}</p>
    <p class="mt-3 flex-1 text-sm leading-relaxed">{tagline}</p>
    <TechTags tech={tech} class="mt-4" />
  </div>
</article>
