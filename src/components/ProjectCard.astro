---
import type { CollectionEntry } from 'astro:content';
import TechTags from './TechTags.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, tagline, role, tech, status } = project.data;

const badge = {
  live: null,
  'in-progress': 'In progress',
  'client-work': 'Client work',
  'personal-project': 'Personal project',
  'masters-thesis': "Master's thesis",
}[status ?? 'live'];
---

<article class="group relative flex flex-col rounded-xl border border-zinc-200 bg-zinc-50 p-5 transition hover:border-accent dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-accent-soft" data-reveal>
  <div class="flex items-start justify-between gap-3">
    <h3 class="text-lg font-semibold">
      <a href={`/projects/${project.id}/`} class="after:absolute after:inset-0">{title}</a>
    </h3>
    {badge && (
      <span class="shrink-0 rounded-full bg-zinc-100 px-2 py-0.5 font-mono text-xs dark:bg-zinc-800">{badge}</span>
    )}
  </div>
  <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">{role}</p>
  <p class="mt-3 flex-1 text-sm leading-relaxed">{tagline}</p>
  <TechTags tech={tech} class="mt-4" />
</article>
