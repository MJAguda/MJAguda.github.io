---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SkillChips from '../components/SkillChips.astro';
import TechTags from '../components/TechTags.astro';
import { siGithub, siYoutube, type SimpleIcon } from 'simple-icons';
import { Image } from 'astro:assets';
import photo from '../assets/mark-jayson-aguda.jpg';
import { profile, about, skills, experience, education, teaching } from '../data/profile';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
// Simple Icons has no LinkedIn logo, so LinkedIn shows its `mark` text instead.
const socialIcons: Record<string, SimpleIcon> = { GitHub: siGithub, YouTube: siYoutube };

const button = 'inline-flex items-center rounded-lg px-4 py-2 text-sm font-medium transition';
const sectionTitle = 'font-mono text-2xl font-bold tracking-tight';
---

<Layout>
  <section class="py-20 sm:py-28">
    <p class="font-mono font-medium text-accent dark:text-accent-soft" aria-hidden="true">$ whoami<span class="prompt-cursor"></span></p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight sm:text-5xl">{profile.name}</h1>
    <p class="mt-3 text-xl text-zinc-900 sm:text-2xl dark:text-zinc-100">
      {profile.role} <span class="text-zinc-600 dark:text-zinc-400">· {profile.focus}</span>
    </p>
    <p class="mt-6 max-w-2xl leading-relaxed">{profile.pitch}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={profile.resume} download class={`${button} bg-accent text-white hover:opacity-90 dark:bg-accent-soft dark:text-zinc-950`}>Download résumé</a>
      <a href={`mailto:${profile.email}`} class={`${button} border border-zinc-300 hover:border-accent dark:border-zinc-700 dark:hover:border-accent-soft`}>Email me</a>
      {profile.socials.map((s) => (
        <a href={s.href} aria-label={s.label} title={s.label} class="inline-flex size-10 items-center justify-center rounded-lg border border-zinc-300 transition hover:border-accent hover:text-accent dark:border-zinc-700 dark:hover:border-accent-soft dark:hover:text-accent-soft">
          {socialIcons[s.label]
            ? <svg class="size-6 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d={socialIcons[s.label].path} /></svg>
            : <span class="font-mono text-base font-bold" aria-hidden="true">{s.mark}</span>}
        </a>
      ))}
    </div>
  </section>

  <section id="about" class="scroll-mt-20 py-12">
    <h2 class={sectionTitle} data-reveal><span aria-hidden="true" class="text-accent dark:text-accent-soft">{'// '}</span><span class="lowercase">About</span></h2>
    <div class="mt-6 flex flex-col gap-6 sm:flex-row-reverse sm:items-start sm:gap-10">
      <Image
        src={photo}
        alt={`Portrait of ${profile.name}`}
        width={160}
        height={160}
        densities={[1, 2]}
        class="size-32 shrink-0 rounded-full border-2 border-accent object-cover sm:size-40 dark:border-accent-soft"
        data-reveal=""
      />
      <div class="max-w-2xl space-y-4 leading-relaxed">
        {about.map((paragraph) => <p data-reveal>{paragraph}</p>)}
      </div>
    </div>
  </section>

  <section id="projects" class="scroll-mt-20 py-12">
    <h2 class={sectionTitle} data-reveal><span aria-hidden="true" class="text-accent dark:text-accent-soft">{'// '}</span><span class="lowercase">Projects</span></h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section id="skills" class="scroll-mt-20 py-12">
    <h2 class={sectionTitle} data-reveal><span aria-hidden="true" class="text-accent dark:text-accent-soft">{'// '}</span><span class="lowercase">Skills</span></h2>
    <dl class="mt-6 grid gap-x-8 gap-y-5 sm:grid-cols-[12rem_1fr]">
      {Object.entries(skills).map(([group, items]) => (
        <>
          <dt class="font-mono font-semibold text-zinc-900 dark:text-zinc-100" data-reveal>{group}</dt>
          <dd class="-mt-3 sm:mt-0" data-reveal><SkillChips items={items} /></dd>
        </>
      ))}
    </dl>
  </section>

  <section id="experience" class="scroll-mt-20 py-12">
    <h2 class={sectionTitle} data-reveal><span aria-hidden="true" class="text-accent dark:text-accent-soft">{'// '}</span><span class="lowercase">Experience</span></h2>
    <ol class="mt-6 space-y-8 border-l border-zinc-200 pl-6 dark:border-zinc-800">
      {experience.map((job) => (
        <li class="relative" data-reveal>
          <span class="absolute -left-[1.85rem] top-1.5 size-3 rounded-full border-2 border-accent bg-white dark:border-accent-soft dark:bg-zinc-950"></span>
          <div class="flex flex-wrap items-baseline justify-between gap-x-4">
            <h3 class="font-semibold">
              {job.title} ·{' '}
              {job.url
                ? <a href={job.url} class="hover:text-accent dark:hover:text-accent-soft">{job.company} ↗</a>
                : job.company}
            </h3>
            <p class="font-mono text-sm text-zinc-600 dark:text-zinc-400">{job.period}</p>
          </div>
          <p class="mt-2 leading-relaxed">{job.summary}</p>
          <TechTags tech={job.tech} class="mt-3" />
        </li>
      ))}
    </ol>
  </section>

  <section id="education" class="scroll-mt-20 py-12">
    <h2 class={sectionTitle} data-reveal><span aria-hidden="true" class="text-accent dark:text-accent-soft">{'// '}</span><span class="lowercase">Education</span></h2>
    <ul class="mt-6 space-y-3">
      {education.map((e) => (
        <li class="flex flex-wrap items-baseline justify-between gap-x-4" data-reveal>
          <span>
            <span class="font-medium text-zinc-900 dark:text-zinc-100">{e.degree}</span>, {e.school}
            {e.note && <span class="block text-sm text-zinc-600 dark:text-zinc-400">{e.note}</span>}
          </span>
          <span class="font-mono text-sm text-zinc-600 dark:text-zinc-400">{e.period}</span>
        </li>
      ))}
    </ul>
  </section>

  <section id="teaching" class="scroll-mt-20 py-12">
    <h2 class={sectionTitle} data-reveal><span aria-hidden="true" class="text-accent dark:text-accent-soft">{'// '}</span><span class="lowercase">Teaching & publications</span></h2>
    <ul class="mt-6 space-y-6">
      {teaching.map((t) => (
        <li data-reveal>
          <div class="flex flex-wrap items-baseline justify-between gap-x-4">
            <h3 class="font-semibold">{t.title}</h3>
            <p class="font-mono text-sm text-zinc-600 dark:text-zinc-400">{t.period}</p>
          </div>
          <p class="mt-1 leading-relaxed">{t.detail}</p>
          {t.link && (
            <a href={t.link.href} class="mt-1 inline-block text-sm font-medium text-accent underline underline-offset-4 dark:text-accent-soft">{t.link.label} ↗</a>
          )}
        </li>
      ))}
    </ul>
  </section>

  <section id="contact" class="scroll-mt-20 py-12">
    <h2 class={sectionTitle} data-reveal><span aria-hidden="true" class="text-accent dark:text-accent-soft">{'// '}</span><span class="lowercase">Contact</span></h2>
    <p class="mt-4 max-w-2xl leading-relaxed" data-reveal>
      I'm open to full-stack and backend roles. The quickest way to reach me is email.
    </p>
    <a href={`mailto:${profile.email}`} class="mt-4 inline-block text-lg font-medium text-accent underline underline-offset-4 dark:text-accent-soft" data-reveal>
      {profile.email}
    </a>
  </section>

  <script>
    // Scroll reveal (styles in global.css). Items below the fold at load wait, then fade up once when they enter.
    // Anything in view at load, or in the section a direct /#hash load targets, is never hidden.
    const hashSection = location.hash.slice(1);
    const io = new IntersectionObserver((entries) => {
      let step = 0;
      for (const { target, isIntersecting } of entries) {
        const el = target as HTMLElement;
        if (!el.dataset.reveal) {
          if (isIntersecting || el.closest('section')?.id === hashSection) io.unobserve(el);
          else el.dataset.reveal = 'wait';
          continue;
        }
        if (!isIntersecting) continue;
        el.style.setProperty('--reveal-delay', `${Math.min(step, 4) * 70}ms`);
        el.dataset.reveal = 'in';
        io.unobserve(el);
        if (el.tagName !== 'DT') step++; // a skill row's dt and dd share one step
      }
    });
    document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
  </script>
</Layout>
